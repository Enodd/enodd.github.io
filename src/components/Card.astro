---
import { Dayjs } from 'dayjs';
interface Props {
	iconUrl: string;
	title: string;
	description: string;
	startDate: Dayjs;
	endDate: Dayjs | 'present';
	tags: string[];
}
const { iconUrl, title, description, startDate, endDate, tags} = Astro.props;
---
<div class="card flex flex-row">
	<img src={iconUrl} alt={`${title} icon`}>
	<div>
		<div>
			{`${startDate.format('YYYY')}-${endDate === 'present' ? 'present' : endDate.format('YYYY')}`}
		</div>
		<div>
			<h3>{title}</h3>
			<p>{description}</p>
		</div>
	</div>
</div>
<style lang="postcss">
	.card {
		aspect-ratio: 905/350;
		border: 2px solid red;
		background-image: url('/images/TickerCard.svg');
		background-repeat: no-repeat;
		min-height: 350px;
	}
</style>