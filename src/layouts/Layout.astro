---
import '../app.css';
import { ViewTransitions } from 'astro:transitions';
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en" transition:animate="none">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Astro description" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Mulish:ital,wght@0,200..1000;1,200..1000&display=swap" rel="stylesheet">
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<ViewTransitions />
	</head>
	<body class="bg-background-site">
		<header class="bg-background-site flex flex-row justify-center items-center">
			<div
			 class="py-4 px-8 fhd:px-4 flex flex-row justify-between items-center w-full max-w-screen-fhd border-b-2 border-b-contrastLight">
				<div class="flex flex-row items-center gap-2">
					<img src={'/images/favicon.svg'} alt="website logo" />
					<h1>Enodd</h1>
				</div>
				<nav>
                    <ul class="flex gap-5 list-none">
                        <li>About</li>
                        <li>Work</li>
                        <li>Contact</li>
				    </ul>
				</nav>
			</div>
		</header>
		<slot transition:animate="slide" />
	</body>
</html>
