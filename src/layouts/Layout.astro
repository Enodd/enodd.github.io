---
import { Header } from "@layouts/Header/Header";
import "../app.css";
import { ViewTransitions } from "astro:transitions";
import Footer from "@layouts/Footer.astro";
import { FaGithub, FaInstagram } from "react-icons/fa";
import { FaXTwitter } from "react-icons/fa6";
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en" transition:animate="none">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Astro description" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/images/newLogo.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Roboto+Slab:wght@100..900&display=swap"
			rel="stylesheet"
		/>
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<ViewTransitions />
		<script>
			import gsap from "gsap";
			import { useGSAP } from "@gsap/react";
			import { useMessageOfTheDay } from "@hooks/useMessageOfTheDay";
			gsap.registerPlugin(useGSAP);

			const { getMessage } = useMessageOfTheDay();

			const message = document.getElementById("messageOfTheDay");
			if (message !== undefined && message !== null) {
				window.addEventListener("DOMContentLoaded", () => {
					message.innerText = getMessage();
				});
			}
			const header: HTMLDivElement | null =
				document.querySelector("#core-header");

			const observer = new IntersectionObserver(
				([e]) => {
					e.target.classList.toggle(
						"isSticky",
						e.intersectionRatio < 1,
					);
					console.log("observing...");
				},
				{ threshold: 1 },
			);

			if (window !== undefined && header !== null) {
				observer.observe(header);
			}
		</script>
		<!-- <style>
			html {
				overflow-x: hidden;
			}
		</style> -->
	</head>
	<body class="bg-primary">
		<div class="mediabar relative">
			<a href="https://github.com/enodd">
				<FaGithub size={24} color="inherit" />
			</a>
			<a href="https://x.com/enodd_dev">
				<FaXTwitter size={24} color="inherit" />
			</a>
			<!-- TODO: create instagram account and link it here -->
			<!-- <a href="#">
				<FaInstagram size={24} color="inherit" />
			</a> -->
			<div class="absolute left-[50%] translate-x-[-50%]">
				<!-- Here's random message out of the pool -->
				<p
					id="messageOfTheDay"
					class="text-background-dark uppercase font-black"
				>
				</p>
			</div>
		</div>
		<Header client:load />
		<div class="container px-6 max-w-[100%]">
			<slot transition:animate="slide" />
		</div>
		<Footer />
	</body>
</html>
