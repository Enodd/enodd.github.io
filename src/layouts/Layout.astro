---
import { Header } from "@layouts/Header/Header";
import "../app.css";
import { ViewTransitions } from "astro:transitions";
import Footer from "@layouts/Footer.astro";
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en" transition:animate="none">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Astro description" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Mulish:ital,wght@0,200..1000;1,200..1000&display=swap"
			rel="stylesheet"
		/>
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<ViewTransitions />
		<script>
			import gsap from "gsap";
			import { useGSAP } from "@gsap/react";
			gsap.registerPlugin(useGSAP);

			const header: HTMLDivElement | null =
				document.querySelector("#core-header");
			let prevScrollPos = window.scrollY;
			const headerTimeline = gsap
				.timeline({
					paused: true,
					reversed: true,
				})
				.fromTo(
					header,
					{
						y: "0x",
					},
					{ y: "-100%" },
				)
				.duration(0.1);

			window.addEventListener("scroll", () => {
				if (window === undefined || header === null) return;
				if (window.scrollY < prevScrollPos || window.scrollY <= 0) {
					!headerTimeline.reversed() && headerTimeline.reverse(0);
				} else {
					headerTimeline.play();
				}
				prevScrollPos = window.scrollY;
			});
		</script>
		<style>
			html,
			body {
				overflow-x: hidden;
			}
		</style>
	</head>
	<body class="bg-background-site">
		<Header client:load />
		<slot transition:animate="slide" />
		<Footer />
	</body>
</html>
