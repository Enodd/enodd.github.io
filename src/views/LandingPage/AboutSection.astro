---
import { Quoteblock } from "@components/Quoteblock";

const quote: string =
	'Between creation and creativity there is a place where the two intertwine\nto create stunning designs into which life is breathed turning them into eye-catching websites.';
---

<script>
  import { gsap } from 'gsap';
  const section = document.querySelector('#aboutSection');
  const heroImage = document.querySelector('#heroImage');
  const myTimeline = gsap.timeline();
  const heroImageTimeline = gsap.timeline({ repeat: -1, repeatDelay: 0, defaults: { ease: 'none', duration: 3 } });

  heroImageTimeline
	.fromTo(heroImage, { y: '0%' }, { y: '-1%'})
	.fromTo(heroImage, { y: '-1%' }, { y: '1%' })
	.fromTo(heroImage, { y: '1%' }, { y: '0%' })

  myTimeline
  .from(section, {
    opacity: 0
  })
  .to(section, {
    opacity: 1,
  })
  .duration(0.4);

</script>
<section
    id={'aboutSection'}
    class="py-10 px-10 flex flex-col items-center gap-12 md:px-0"
>
	<div class="wrapper flex flex-col items-center">
		<h2 class="font-bold uppercase mb-6 text-lg">About</h2>
	</div>
	<Quoteblock client:load quote={quote} separator="\n" size="3xl" />
		<img id='heroImage' src={'/images/programming_openSourceUndraw.svg'} alt="An Ilustration showing a blonde haired man programming" class="float"/>
		<div class="flex flex-col gap-4 w-full items-center md:items-start md:max-w-screen-sm m-4">
			<h3 class="text-5xl font-bold">
				Welcome
			</h3>
			<div class="flex flex-col gap-5">
				<p>
					My name is <span>Damian</span>, I'm Front-end Developer loving his job, building Websites and Web3 dapps.
				</p>
				<p>
					With <span>React</span> as my main framework I'm not closed for other tools. Whenever there's opportunity to learn new things, Count me in.
				</p>
			</div>
		</div>
	</div>
</section>
<style lang="postcss">
	h3 {
		@apply relative;
	}
	h3::after {
		content: '';
		height: 3px;
		@apply w-full scale-x-100 md:scale-x-0 bg-secondary-dark absolute bottom-[-5px] left-0;
		transition: 300ms;
		transform-origin: center;
	}
	h3:hover::after {
		@apply scale-x-100;
	}
</style>